# SQLite by default; for Neon paste the connection string (sslmode=require is handled).
DATABASE_URL=sqlite+aiosqlite:///./refundrx.db
# Without a key the deterministic offline planner is used (recorded as such in audit_log).
GROQ_API_KEY=
PLANNER_BACKEND=auto
# qdrant = bge-small-en-v1.5 hybrid retrieval; keyword = no model download
RAG_BACKEND=qdrant
API_BASIC_AUTH_USER=
API_BASIC_AUTH_PASSWORD=
RATE_LIMIT_PER_MINUTE=20
# UI only
API_URL=http://localhost:8000
APP_PASSWORD=
